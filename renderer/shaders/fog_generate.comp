float fade(float t)
{
  return t * t * t * (t * (t * 6.f - 15.f) + 10.f);
}

float grad(int hash, vec3 p)
{
  int h = hash & 15;

  float u = h < 8 ? p.x : p.y;

  float v;
  if (h < 4)
    v = p.y;
  else if (h == 12 || h == 14)
    v = p.x;
  else
    v = p.z;

  return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}

float perlin(vec3 p)
{
  ivec3 i = ivec3(floor(p));
  vec3 f = fract(p);

  vec3 u = vec3(fade(f.x), fade(f.y), fade(f.z));

  int X = i.x & 255;
  int Y = i.y & 255;
  int Z = i.z & 255;

  int A  = perm[X] + Y;
  int AA = perm[A] + Z;
  int AB = perm[A + 1] + Z;

  int B  = perm[X + 1] + Y;
  int BA = perm[B] + Z;
  int BB = perm[B + 1] + Z;

  float x1 = mix(grad(perm[AA], f), grad(perm[BA], f - vec3(1.f, 0.f, 0.f)), u.x);
  float x2 = mix(grad(perm[AB], f - vec3(0.f, 1.f, 0.f)), grad(perm[BB], f - vec3(1.f, 1.f, 0.f)), u.x);
  float y1 = mix(x1, x2, u.y);
  float x3 = mix(grad(perm[AA + 1], f - vec3(0.f, 0.f, 1.f)), grad(perm[BA + 1], f - vec3(1.f, 0.f, 1.f)), u.x);
  float x4 = mix(grad(perm[AB + 1], f - vec3(0.f, 1.f, 1.f)), grad(perm[BB + 1], f - vec3(1.f, 1.f, 1.f)), u.x);

  float y2 = mix(x3, x4, u.y);

  return mix(y1, y2, u.z);
}

float fbm(vec3 p, int octaves)
{
  float value = 0.f;
  float amplitude = 0.5f;

  for (int i = 0; i < octaves; i++)
  {
    value += amplitude * perlin(p);

    p *= 2.f;
    amplitude *= 0.5f;
  }

  return 0.5f * value + 0.5f;
}

float density_noise(vec3 p, float rng_min, float rng_max, int n, float scale, float wind_inf)
{
  const vec2 wind2d = -constants.weatherData.windDirection * constants.weatherData.windStrength;
  const vec3 wind = vec3(wind2d.x, 0.f, wind2d.y) * constants.time;
  float base = fbm((p + wind * wind_inf) / scale, n);
  return smoothstep(rng_min, rng_max, base);
}

float density_base(vec3 p)
{
  float height = exp(-max(p.y - heightDensityBase, 0.f) * heightDensityFalloff);
  return height * densityO;
}

float density(vec3 p, float dist)
{
  const vec2 wind2d = -constants.weatherData.windDirection * constants.weatherData.windStrength;
  const vec3 wind = vec3(wind2d.x, 0.f, wind2d.y) * constants.time;
  float shape = 1.f;
  float detail = 1.f;
  float shapeFadeout = smoothstep(0.f, 1.f, (dist - 280.f) / 1000.f);
  float detailFadeout = smoothstep(0.f, 1.f, (dist - 50.f) / 50.f);
  if (shapeFadeout < 0.9999f)
    shape = density_noise(p, 0.4f, 0.7f, 3, shapeDensityScale, shapeDensityWindInfluence);
  float shapeFaded = mix(shape, 1.f, shapeFadeout);
  float detailFaded = mix(detail, 1.f, detailFadeout);
  return density_base(p) * shapeFaded * detailFaded;
}

float random(vec3 st)
{
  return fract(sin(dot(st.xy * st.z, vec2(145.f, 7.233f))) * 4274.8420509421345434f);
}

void main(void)
{
  ivec2 imCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 imSize = ivec2(constants.mainTargetResolution) / 2;

  if (imCoord.x >= imSize.x || imCoord.y >= imSize.y)
    return;

  const bool scatterAllLights = sceneLightsScatterCoeff >= SHADER_EPSILON;

  const vec2 invaspect = vec2(1.f / viewParams.mProj[0][0], 1.f / viewParams.mProj[1][1]);
  const vec2 uv = vec2(2 * imCoord + 1) * constants.mainTargetInverseResolution;
  const vec2 ndcuv = 2.f * uv - 1.f;
  const vec3 ray = vec3(ndcuv * invaspect, 1.f);
  const float raylen = length(ray);
  const vec3 dir = ray / raylen;

  const float clipDepth = textureLod(gbufDepth, uv, 0.f).x;
  const float linearDepth = linearize_z(clipDepth, viewParams, viewData);
  const float worldDepth = raylen * linearDepth;

  const vec3 worldDir = mat3(viewParams.mInverseView) * dir;

  vec3 pos = viewParams.viewPos;
  vec3 vpos = vec3(0.f);
  float stepSize = min(worldDepth / raymarchSteps, maxStepSize);
  vec3 posStep = worldDir * stepSize;
  vec3 vposStep = dir * stepSize;
  vec4 transmitted = vec4(0.f, 0.f, 0.f, 1.f);
  float dist = 0.f;
  float pdd = density(pos, dist);
  for (int s = 0; s < raymarchSteps; ++s)
  {
    float ndd = density(pos, dist);
    float dd = (ndd + pdd) * 0.5f;
    pdd = ndd;
    if (dd < 0.000001f)
    {
      pos += posStep;
      vpos += vposStep;
      dist += stepSize;
      continue;
    }

    float ii = constantInscatter;

    float stp = exp(-dd * stepSize); 
    transmitted.a *= stp;

    CsmCascadeLightingData csmd = get_cascade_data_for_view_pos(vpos, viewParams);
    for (int i = 0; i < (scatterAllLights ? lights.directionalLightsCount : min(1, lights.directionalLightsCount)); ++i)
    {
      LightData ld = calculate_directional_light_data(i, pos, csmd);
      vec3 inscatter = ii * ld.intensity * ld.shadow; // * phase
      transmitted.rgb += transmitted.a * inscatter * stp;
    }

    for (int i = 0; i < (scatterAllLights ? lights.pointLightsCount : 0); ++i)
    {
      LightData ld = calculate_point_light_data(i, pos);
      vec3 inscatter = ii * ld.intensity * ld.shadow * sceneLightsScatterCoeff; // * phase
      transmitted.rgb += transmitted.a * inscatter * stp * dd;
    }
    for (int i = 0; i < (scatterAllLights ? lights.spotLightsCount : 0); ++i)
    {
      LightData ld = calculate_spot_light_data(i, pos);
      vec3 inscatter = ii * ld.intensity * ld.shadow * sceneLightsScatterCoeff; // * phase
      transmitted.rgb += transmitted.a * inscatter * stp * dd;
    }

    pos += posStep;
    vpos += vposStep;
    dist += stepSize;
  }

  float finalTracedLinearDepth = vpos.z;
  float finDepth = min(linearDepth, viewParams.viewFrustum.farZ);
  if (finDepth > finalTracedLinearDepth)
  {
    vec3 startPoint = pos;
    vec3 endPoint = viewParams.viewPos + (pos - viewParams.viewPos) * (finDepth / finalTracedLinearDepth);
    float distantStepSize = raylen * (finDepth - finalTracedLinearDepth) / distantSteps;
    vec3 distantStep = worldDir * distantStepSize;
    for (int s = 0; s < distantSteps; ++s)
    {
      transmitted.a *= exp(-density_base(pos) * distantStepSize);
      pos += distantStep;
    }
  }

  imageStore(fogHalfres, imCoord, transmitted);
}
